package templates

import "github.com/ajorgensen/ourlibrary/internal/database/store"

templ Home(user store.User, library *store.Library, books []store.Book) {
	@Layout("Our Library") {
		<div x-data="{ open: false }" x-on:book-created.window="open = false; $refs.form.reset(); $dispatch('close-isbn-scanner')">
			<header class="border-b border-base-300 bg-base-100">
				<div class="navbar mx-auto max-w-6xl px-4 sm:px-6">
					<div class="flex-1">
						<a class="text-xl font-bold" href="/">Our Library</a>
					</div>
					<div class="flex items-center gap-3">
						<span class="hidden text-sm text-base-content/65 sm:inline">{ user.Email }</span>
						if library != nil {
							<button class="btn btn-primary" type="button" x-on:click="open = true">Add a book</button>
						}
						<form method="post" action="/logout">
							<button class="btn btn-ghost" type="submit">Log out</button>
						</form>
					</div>
				</div>
			</header>
			<main class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
				if library == nil {
					<div class="rounded-box border border-dashed border-base-300 bg-base-100 p-12 text-center">
						<p class="mb-2 text-sm font-semibold uppercase tracking-widest text-primary">Account ready</p>
						<h1 class="text-3xl font-bold tracking-tight">You do not belong to a library yet.</h1>
						<p class="mt-3 text-base-content/60">Ask a library owner to add your account.</p>
					</div>
				} else {
					<div class="mb-8 max-w-2xl">
						<p class="mb-2 text-sm font-semibold uppercase tracking-widest text-primary">{ library.Name }</p>
						<h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Books worth sharing.</h1>
						<p class="mt-4 text-lg text-base-content/70">Keep a simple catalog of the books in your shared collection.</p>
					</div>
					<div id="book-list">
						@BookList(books)
					</div>
				}
			</main>
			if library != nil {
				<div
					x-cloak
					x-show="open"
					x-on:keydown.escape.window="open = false; $dispatch('close-isbn-scanner')"
					class="fixed inset-0 z-50 flex items-center justify-center p-4"
					role="dialog"
					aria-modal="true"
					aria-labelledby="add-book-title"
				>
					<button class="absolute inset-0 bg-neutral/60" type="button" aria-label="Close" x-on:click="open = false; $dispatch('close-isbn-scanner')"></button>
					<div class="card z-10 w-full max-w-lg bg-base-100 shadow-2xl">
						<form
							x-ref="form"
							class="card-body"
							hx-post="/books"
							hx-target="#book-list"
							hx-swap="innerHTML"
						>
							<h2 id="add-book-title" class="card-title text-2xl">Add a book</h2>
							<div
								x-cloak
								x-show="cameraAvailable"
								class="space-y-3"
								x-data="isbnScanner()"
								x-on:close-isbn-scanner.window="close()"
							>
								<div class="flex items-center justify-between gap-3">
									<div>
										<h3 class="font-semibold">Scan ISBN</h3>
										<p class="text-sm text-base-content/60">Use a barcode or printed ISBN.</p>
									</div>
									<button
										class="btn btn-secondary btn-sm"
										type="button"
										x-show="!active"
										x-on:click="start()"
										x-text="detectedISBN || error ? 'Scan again' : 'Open camera'"
									></button>
									<button class="btn btn-ghost btn-sm" type="button" x-show="active" x-on:click="stop()">Stop</button>
								</div>
								<div x-cloak x-show="active" class="relative aspect-video overflow-hidden rounded-box bg-neutral">
									<video x-ref="video" class="h-full w-full object-cover" autoplay muted playsinline></video>
									<div class="pointer-events-none absolute inset-x-[5%] top-[26%] h-[48%] rounded-lg border-2 border-white shadow-[0_0_0_999px_rgba(0,0,0,0.35)]"></div>
								</div>
								<canvas x-ref="canvas" class="hidden"></canvas>
								<p class="text-sm text-base-content/70" aria-live="polite" x-text="status"></p>
								<div x-cloak x-show="detectedISBN" class="alert alert-success py-3" role="status">
									<div>
										<p class="font-semibold" x-text="detectedISBN"></p>
										<p class="text-xs" x-text="`Detected from ${detectionMethod}`"></p>
									</div>
								</div>
								<p x-cloak x-show="error" class="text-sm text-error" role="alert" x-text="error"></p>
								<details x-cloak x-show="lastOCRText" class="text-xs text-base-content/60">
									<summary>Last text recognized</summary>
									<pre class="mt-1 whitespace-pre-wrap" x-text="lastOCRText"></pre>
								</details>
								<div class="divider my-0">or enter details</div>
							</div>
							<label class="form-control">
								<span class="label-text mb-2 font-medium">Title</span>
								<input class="input input-bordered w-full" name="title" required/>
							</label>
							<label class="form-control">
								<span class="label-text mb-2 font-medium">Author</span>
								<input class="input input-bordered w-full" name="author" required/>
							</label>
							<div id="form-error" class="text-sm text-error"></div>
							<div class="card-actions mt-2 justify-end">
								<button class="btn btn-ghost" type="button" x-on:click="open = false; $dispatch('close-isbn-scanner')">Cancel</button>
								<button class="btn btn-primary" type="submit">Add book</button>
							</div>
						</form>
					</div>
				</div>
			}
		</div>
	}
}

templ BookList(books []store.Book) {
	if len(books) == 0 {
		<div class="rounded-box border border-dashed border-base-300 bg-base-100 p-12 text-center">
			<h2 class="text-xl font-semibold">The shelves are empty</h2>
			<p class="mt-2 text-base-content/60">Add the first book to your collection.</p>
		</div>
	} else {
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			for _, book := range books {
				<article class="card border border-base-300 bg-base-100 shadow-sm">
					<div class="card-body">
						<h2 class="card-title">{ book.Title }</h2>
						<p class="text-base-content/65">by { book.Author }</p>
					</div>
				</article>
			}
		</div>
	}
}

templ FormError(message string) {
	<p role="alert">{ message }</p>
}
